  "overrides": [
    {
      "id": "youtube",
      "match": [
        "youtube.com",
        "youtu.be",
        "m.youtube.com",
        "music.youtube.com"
      ],
      "css": "body.yt-fill-active .html5-video-player.ytp-fullscreen .html5-video-container{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;left:0!important;top:0!important;transform:none!important}body.yt-fill-active .html5-video-player.ytp-fullscreen .html5-video-container video,body.yt-fill-active .html5-video-player.ytp-fullscreen video.html5-main-video{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;left:0!important;top:0!important;max-width:none!important;max-height:none!important;transform:none!important;object-fit:fill!important;object-position:center center!important}",
      "activeClass": "yt-fill-active",
      "fullscreenOnly": true,
      "fullscreenHint": {
        "selector": ".html5-video-player",
        "class": "ytp-fullscreen"
      },
      "events": [
        "yt-navigate-finish",
        "yt-page-data-updated"
      ]
    },
    {
      "id": "netflix",
      "match": "netflix.com",
      "css": "html.ws-fill-active:not(.ws-fill-portrait) .watch-video video,html.ws-fill-active:not(.ws-fill-portrait) .watch-video--player-view video,html.ws-fill-active:not(.ws-fill-portrait) [data-uia=\"video-canvas\"] video,html.ws-fill-active:not(.ws-fill-portrait) .nfp video{width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;object-fit:fill!important;object-position:center center!important}"
    },
    {
      "id": "tvsportslive",
      "match": "tvsportslive.fr",
      "css": "body.ws-fill-active iframe[data-ws-stream=\"1\"],body.ws-fill-active iframe[src*=\"embedsports\"]{width:100%!important;max-width:none!important;height:min(80vh,720px)!important;aspect-ratio:auto!important;display:block!important}body.ws-fill-active #theater-clean-view > div:nth-child(2){width:100%!important;flex:1 1 auto!important}body.ws-fill-active #theater-clean-view #theater-chat-sidebar{display:none!important}body.ws-fill-active #theater-clean-view iframe{width:100%!important;height:100%!important;border:none!important}"
    }
  ]
